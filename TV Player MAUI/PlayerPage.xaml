<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.MAUI;assembly=LibVLCSharp.MAUI"
             x:Class="TV_Player.Maui.PlayerPage"
             Padding="0"
             NavigationPage.HasNavigationBar="False">
  <Grid x:Name="PlayerLayout" BackgroundColor="#050A12" RowDefinitions="*" ColumnDefinitions="*">
    <vlc:MediaPlayerElement x:Name="VideoPlayer"
                            Grid.Row="0"
                            Grid.Column="0"
                            EnableRendererDiscovery="False"
                            Loaded="OnPlayerLoaded"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill" />
    <BoxView Grid.Row="0" Grid.Column="0" BackgroundColor="Transparent">
      <BoxView.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnVideoTapped" />
      </BoxView.GestureRecognizers>
    </BoxView>
    <Grid x:Name="PlayerTopBar" Grid.Row="0" Grid.Column="0" ColumnDefinitions="48,*,Auto,48" Padding="8,6" BackgroundColor="#D90A121E" VerticalOptions="Start">
      <Button Text="‹" FontSize="30" Padding="0" Clicked="OnBackClicked" />
      <Label x:Name="ChannelTitle" Grid.Column="1" FontSize="19" FontAttributes="Bold" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
      <Label x:Name="ClockLabel" Grid.Column="2" FontSize="17" VerticalTextAlignment="Center" Margin="8,0" />
      <Button Grid.Column="3" Text="☷" Padding="0" Clicked="OnPickerClicked" />
    </Grid>
    <Grid x:Name="PlayerBottomBar" Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto" BackgroundColor="#E609101B" Padding="12,8" VerticalOptions="End">
      <Grid x:Name="ProgramInfoPanel" IsVisible="False" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" Padding="4,2,4,8">
        <Grid.GestureRecognizers>
          <TapGestureRecognizer Tapped="OnGuideInfoTapped" />
        </Grid.GestureRecognizers>
        <Label x:Name="ProgramTitleLabel" Grid.ColumnSpan="2" FontSize="16" LineBreakMode="TailTruncation" />
        <Label x:Name="ProgramStartLabel" Grid.Row="1" FontSize="12" TextColor="#8DD2FF" VerticalTextAlignment="Center" Margin="0,0,8,0" />
        <ProgressBar x:Name="ProgramProgress" Grid.Row="1" Grid.Column="1" Progress="0" ProgressColor="#55B9FF" VerticalOptions="Center" />
        <Label x:Name="ProgramEndLabel" Grid.Row="1" Grid.Column="2" FontSize="12" TextColor="#8DD2FF" HorizontalOptions="End" VerticalTextAlignment="Center" Margin="8,0,0,0" />
      </Grid>
      <Label x:Name="StatusLabel" Grid.Row="1" FontSize="14" TextColor="#8DD2FF" />
      <ScrollView x:Name="ProgramGuideList" Grid.Row="2" Orientation="Horizontal" IsVisible="False" HeightRequest="84">
        <HorizontalStackLayout x:Name="ProgramGuideItems" Spacing="8" />
      </ScrollView>
      <ScrollView x:Name="ChannelPicker" Grid.Row="3" Orientation="Horizontal" IsVisible="False" HeightRequest="92">
        <HorizontalStackLayout x:Name="ChannelPickerItems" Spacing="8" />
      </ScrollView>
    </Grid>
    <BoxView x:Name="PrivacyOverlay" Grid.Row="0" Grid.Column="0" IsVisible="False" InputTransparent="True" BackgroundColor="#D909101B" />
  </Grid>
</ContentPage>
