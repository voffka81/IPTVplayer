<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.MAUI;assembly=LibVLCSharp.MAUI"
             x:Class="TV_Player.Maui.PlayerPage"
             Padding="0"
             NavigationPage.HasNavigationBar="False">
  <Grid BackgroundColor="#050A12" RowDefinitions="Auto,*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="48,*,Auto,48" Padding="8,6" BackgroundColor="#D90A121E">
      <Button Text="‹" FontSize="30" Padding="0" Clicked="OnBackClicked" />
      <Label x:Name="ChannelTitle" Grid.Column="1" FontSize="19" FontAttributes="Bold" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
      <Label x:Name="ClockLabel" Grid.Column="2" FontSize="17" VerticalTextAlignment="Center" Margin="8,0" />
      <Button Grid.Column="3" Text="☷" Padding="0" Clicked="OnPickerClicked" />
    </Grid>
    <vlc:MediaPlayerElement x:Name="VideoPlayer"
                            Grid.Row="1"
                            EnableRendererDiscovery="False"
                            Loaded="OnPlayerLoaded" />
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto" BackgroundColor="#E609101B" Padding="12,8">
      <Label x:Name="StatusLabel" FontSize="14" TextColor="#8DD2FF" />
      <ScrollView x:Name="ChannelPicker" Grid.Row="1" Orientation="Horizontal" IsVisible="False" HeightRequest="92">
        <HorizontalStackLayout x:Name="ChannelPickerItems" Spacing="8" />
      </ScrollView>
    </Grid>
  </Grid>
</ContentPage>
