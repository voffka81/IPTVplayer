<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:TV_Player.Maui.Localization"
             x:Class="TV_Player.Maui.ChannelPage"
             Title="{loc:T Key=Tf31014368cbf}">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <Entry x:Name="SearchEntry" Placeholder="{loc:T Key=T8381a827f861}" TextChanged="OnSearchChanged" />
    <CollectionView x:Name="ChannelsView" Grid.Row="1" SelectionMode="None">
      <CollectionView.ItemsLayout><GridItemsLayout x:Name="ChannelGridLayout" Orientation="Vertical" Span="3" HorizontalItemSpacing="10" VerticalItemSpacing="12" /></CollectionView.ItemsLayout>
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border HeightRequest="142" Padding="8" BackgroundColor="#162130" Stroke="#304054" StrokeThickness="1">
            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
            <Grid>
              <Grid RowDefinitions="*,Auto" RowSpacing="6" InputTransparent="True">
                <Image Source="{Binding Logo}" HeightRequest="82" WidthRequest="100" Aspect="AspectFit" />
                <Label Grid.Row="1" Text="{Binding Name}" FontSize="15" LineBreakMode="WordWrap" MaxLines="2" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
              </Grid>
              <Button Text="" BackgroundColor="Transparent" BorderColor="Transparent" BorderWidth="0" Padding="0"
                      AutomationProperties.Name="{Binding Name}"
                      Clicked="OnChannelTapped">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                      <VisualState x:Name="Normal">
                        <VisualState.Setters>
                          <Setter Property="BorderColor" Value="Transparent" />
                          <Setter Property="BorderWidth" Value="0" />
                        </VisualState.Setters>
                      </VisualState>
                      <VisualState x:Name="Focused">
                        <VisualState.Setters>
                          <Setter Property="BorderColor" Value="{StaticResource FocusBorder}" />
                          <Setter Property="BorderWidth" Value="3" />
                        </VisualState.Setters>
                      </VisualState>
                    </VisualStateGroup>
                  </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>
