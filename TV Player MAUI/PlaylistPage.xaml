<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TV_Player.Maui.PlaylistPage"
             Title="IPTV Player">
  <ContentPage.Resources>
    <Style x:Key="SourceButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
      <Setter Property="HeightRequest" Value="108" />
      <Setter Property="FontSize" Value="19" />
    </Style>
  </ContentPage.Resources>
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto,Auto" Padding="4,8">
      <Label Text="IPTV Player" FontSize="25" FontAttributes="Bold" VerticalOptions="Center" />
      <Label x:Name="ClockLabel" Grid.Column="1" FontSize="18" VerticalOptions="Center" Margin="0,0,8,0" />
      <Button Grid.Column="2" Text="⚙" WidthRequest="48" HeightRequest="48" Padding="0" Clicked="OnSettingsClicked" />
    </Grid>
    <Button x:Name="UpdateAvailableButton" Grid.Row="1" IsVisible="False" Clicked="OnUpdateClicked" />
    <CollectionView x:Name="SourcesView" Grid.Row="2" ItemsSource="{Binding Sources}" SelectionMode="None">
      <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" /></CollectionView.ItemsLayout>
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Button Text="{Binding Name}" Style="{DynamicResource SourceButtonStyle}" Clicked="OnSourceClicked" />
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>
