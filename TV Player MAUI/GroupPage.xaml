<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TV_Player.Maui.GroupPage"
             Title="Группы">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <Entry x:Name="SearchEntry" Placeholder="Поиск групп" TextChanged="OnSearchChanged" />
    <VerticalStackLayout Grid.Row="1" Spacing="8">
      <Label x:Name="LoadStatus" Text="Загрузка плейлиста…" TextColor="#91C9FF" />
      <Button x:Name="RetryButton" Text="Повторить загрузку" IsVisible="False" HorizontalOptions="Start" Clicked="OnRetryClicked" />
    </VerticalStackLayout>
    <CollectionView x:Name="GroupsView" Grid.Row="2" SelectionMode="None">
      <CollectionView.ItemsLayout><GridItemsLayout x:Name="GroupGridLayout" Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" /></CollectionView.ItemsLayout>
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border HeightRequest="108" Padding="12,8" BackgroundColor="#162130" Stroke="#304054" StrokeThickness="1">
            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>

            <Grid>
            <VerticalStackLayout Spacing="4" VerticalOptions="Center" InputTransparent="True">
              <Label Text="{Binding Name}" FontSize="18" HorizontalTextAlignment="Center" />
              <Label Text="{Binding Count}" FontSize="13" TextColor="#91C9FF" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
              <Button Text="" AutomationProperties.Name="{Binding Name}" BackgroundColor="Transparent" BorderColor="Transparent" BorderWidth="0" Padding="0" Clicked="OnGroupTapped">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                      <VisualState x:Name="Normal" />
                      <VisualState x:Name="Focused">
                        <VisualState.Setters>
                          <Setter Property="BorderColor" Value="{StaticResource FocusBorder}" />
                          <Setter Property="BorderWidth" Value="3" />
                        </VisualState.Setters>
                      </VisualState>
                    </VisualStateGroup>
                  </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
              </Button>
            </Grid>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>
