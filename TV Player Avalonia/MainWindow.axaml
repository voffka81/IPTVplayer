<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="TV_Player.AvaloniaApp.MainWindow"
        mc:Ignorable="d"
        Icon="/Assets/icon.ico"
        Width="1100"
        Height="680"
        MinWidth="640"
        MinHeight="400"
        Title="TV"
        WindowState="{Binding CurrentWindowState}"
        Background="#090F19">
  <Grid RowDefinitions="Auto,*" Background="#090F19">
    <Border IsVisible="{Binding IsTopPanelVisible}" Height="76" Background="#E609101B" BorderThickness="0">
      <Grid ColumnDefinitions="76,*,90,64,64,64">
        <Button Grid.Column="0" IsVisible="{Binding IsBackButtonVisible}" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="toolbar-flat" Foreground="#F3F7FF" Command="{Binding BackCommand}">
          <Viewbox Width="24" Height="24">
            <Path Stroke="#F3F7FF" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Data="M20 12H4 M11 5L4 12L11 19" />
          </Viewbox>
        </Button>
        <TextBlock Grid.Column="2" Text="{Binding ClockText}" FontSize="21" FontWeight="SemiBold" Foreground="#F5F8FF" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <Button Grid.Column="3" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="toolbar-flat" Foreground="#F3F7FF" IsVisible="{Binding IsSettingsButtonVisible}" Command="{Binding SettingsCommand}">
          <Viewbox Width="18" Height="18">
            <Path Fill="#F3F7FF" Data="M12 8.9A3.1 3.1 0 1 0 12 15.1A3.1 3.1 0 1 0 12 8.9M19.4 13A7.5 7.5 0 0 0 19.5 12A7.5 7.5 0 0 0 19.4 11L21.5 9.4L19.5 5.9L17 6.9A7.2 7.2 0 0 0 15.3 6L14.9 3.3H9.1L8.7 6A7.2 7.2 0 0 0 7 6.9L4.5 5.9L2.5 9.4L4.6 11A7.5 7.5 0 0 0 4.5 12A7.5 7.5 0 0 0 4.6 13L2.5 14.6L4.5 18.1L7 17.1A7.2 7.2 0 0 0 8.7 18L9.1 20.7H14.9L15.3 18A7.2 7.2 0 0 0 17 17.1L19.5 18.1L21.5 14.6L19.4 13Z" />
          </Viewbox>
        </Button>
        <TextBlock Grid.Column="1"
                   Text="{Binding TopPanelTitle}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Margin="12,0,0,0"
                   Foreground="White" />
        <Button Grid.Column="4" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="toolbar-flat" Foreground="#F3F7FF" Command="{Binding FullscreenCommand}">
          <Viewbox Width="16" Height="16">
            <Path Fill="#F3F7FF" Data="M4 9V4H9V6H6V9H4M15 4H20V9H18V6H15V4M20 15V20H15V18H18V15H20M9 20H4V15H6V18H9V20Z" />
          </Viewbox>
        </Button>
        <Button Grid.Column="5" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="toolbar-flat" Foreground="White" Command="{Binding CloseAppCommand}">
          <Viewbox Width="16" Height="16">
            <Path Stroke="White" StrokeThickness="2.5" Data="M5,5 L19,19 M19,5 L5,19" />
          </Viewbox>
        </Button>
      </Grid>
    </Border>

    <!-- Edge-to-edge content: no decorative frame or exposed wallpaper. -->
    <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="{Binding ContentMargin}" />
  </Grid>
</Window>
