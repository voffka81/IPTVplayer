<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
             x:Class="TV_Player.AvaloniaApp.Views.PlayerView">
  <Grid>
    <vlc:VideoView x:Name="VideoView">
      <Grid x:Name="VideoSurfaceRoot" Background="#01000000" PointerPressed="OnOverlayPointerPressed">

    <Grid x:Name="OverlayPanel" Background="#01000000">
      <Grid.RowDefinitions>
        <RowDefinition Height="80" />
        <RowDefinition Height="*" />
        <RowDefinition Height="80" />
      </Grid.RowDefinitions>

      <Border Background="#D90A121E" BorderBrush="#304761" BorderThickness="0">
      <Grid x:Name="PlayerTopBar">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="80" />
        </Grid.ColumnDefinitions>
        <Button x:Name="PlayerNav1" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="toolbar-flat" Command="{Binding BackCommand}">
          <Viewbox Width="20" Height="20">
            <Path Stroke="#F5F8FF" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Data="M20 12H4 M11 5L4 12L11 19" />
          </Viewbox>
        </Button>
        <TextBlock Grid.Column="1" FontSize="20" FontWeight="SemiBold" Foreground="White" Text="{Binding TopPanelTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock x:Name="PlayerClock" Grid.Column="2" Foreground="White" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Button Grid.Column="3" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="toolbar-flat" Command="{Binding SettingsCommand}">
          <Viewbox Width="20" Height="20"><Path Fill="#F5F8FF" Data="M12 8.9A3.1 3.1 0 1 0 12 15.1A3.1 3.1 0 1 0 12 8.9M19.4 13A7.5 7.5 0 0 0 19.5 12A7.5 7.5 0 0 0 19.4 11L21.5 9.4L19.5 5.9L17 6.9A7.2 7.2 0 0 0 15.3 6L14.9 3.3H9.1L8.7 6A7.2 7.2 0 0 0 7 6.9L4.5 5.9L2.5 9.4L4.6 11A7.5 7.5 0 0 0 4.5 12A7.5 7.5 0 0 0 4.6 13L2.5 14.6L4.5 18.1L7 17.1A7.2 7.2 0 0 0 8.7 18L9.1 20.7H14.9L15.3 18A7.2 7.2 0 0 0 17 17.1L19.5 18.1L21.5 14.6L19.4 13Z" /></Viewbox>
        </Button>
        <Button x:Name="PlayerNav2" Grid.Column="4" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="toolbar-flat" Command="{Binding FullscreenCommand}">
          <Viewbox Width="20" Height="20">
            <Path Fill="#F5F8FF" Data="M4 9V4H9V6H6V9H4M15 4H20V9H18V6H15V4M20 15V20H15V18H18V15H20M9 20H4V15H6V18H9V20Z" />
          </Viewbox>
        </Button>
        <Button x:Name="PlayerNav3" Grid.Column="5" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="toolbar-flat" Command="{Binding CloseAppCommand}">
          <Viewbox Width="20" Height="20">
            <Path Stroke="White" StrokeThickness="2.5" Data="M5,5 L19,19 M19,5 L5,19" />
          </Viewbox>
        </Button>
      </Grid>
      </Border>

      <Border Grid.Row="1"
              x:Name="GuidePanel"
              Width="360"
              HorizontalAlignment="Left"
              Background="#E6101928"
              BorderBrush="#304761"
              BorderThickness="0"
              IsVisible="{Binding ProgramGuideVisible}">
        <ItemsControl ItemsSource="{Binding Programs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Vertical" Margin="6,2">
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="15" Foreground="White" TextAlignment="Left" Margin="1,0,1,2" />
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding StartTime, StringFormat='{}{0:HH:mm}'}" FontSize="12" Foreground="#8DD2FF" Margin="1,0,1,2" />
                  <TextBlock Text="{Binding EndTime, StringFormat='{}{0:HH:mm}'}" FontSize="12" Foreground="#8DD2FF" Margin="10,0,1,2" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <Grid x:Name="PlayerBottomBar" Grid.Row="2" Background="#E609101B">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="180" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button x:Name="PlayerNav4" Width="54" Height="54" Classes="toolbar-flat" Command="{Binding PreviousCommand}">
            <Viewbox Width="20" Height="20">
              <Path Fill="#F5F8FF" Data="M14 18L8 12L14 6Z" />
            </Viewbox>
          </Button>
          <Button x:Name="PlayerNav5" Width="54" Height="54" Classes="toolbar-flat" Command="{Binding NextCommand}">
            <Viewbox Width="20" Height="20">
              <Path Fill="#F5F8FF" Data="M10 18L16 12L10 6Z" />
            </Viewbox>
          </Button>
        </StackPanel>

        <Button Grid.Column="1"
                Classes="toolbar-flat"
                IsVisible="{Binding ShowProgramInfo}"
                Command="{Binding ShowProgramListCommand}">
          <StackPanel Spacing="3" HorizontalAlignment="Center">
            <TextBlock FontSize="18" Foreground="White" Text="{Binding ProgramGuideText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <TextBlock FontSize="13" Foreground="#F5F5F5" Text="{Binding StartProgram}" VerticalAlignment="Center" />
              <ProgressBar x:Name="GuideProgress" Height="8" Foreground="#8DD2FF" Value="{Binding DurationValue}" Maximum="100" Width="240" VerticalAlignment="Center" />
              <TextBlock FontSize="13" Foreground="#F5F5F5" Text="{Binding EndProgram}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Button>

        <StackPanel Grid.Column="1"
                    Spacing="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsBuffering}">
          <TextBlock Text="Buffering…" FontSize="15" Foreground="#F5F8FF" HorizontalAlignment="Center" />
          <ProgressBar Width="180" Height="8" IsIndeterminate="True" Foreground="#8DD2FF" />
        </StackPanel>
      </Grid>
    </Grid>

    <Border Background="#D9141F30"
            BorderThickness="0"
            CornerRadius="12"
            Padding="18,12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="20"
            IsVisible="{Binding HasPlaybackStatus}">
      <TextBlock Text="{Binding PlaybackStatus}" Foreground="White" TextWrapping="Wrap" MaxWidth="420" />
    </Border>
      </Grid>
    </vlc:VideoView>
  </Grid>
</UserControl>
