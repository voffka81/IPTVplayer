<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             x:Class="TV_Player.AvaloniaApp.Views.Controls.PlayerChannelPicker">
  <UserControl.Styles>
    <Style Selector="ListBox.channel-picker-list ListBoxItem:selected Border.channel-picker-tile">
      <Setter Property="Background" Value="#1A4263" />
      <Setter Property="BorderBrush" Value="#70D5FF" />
      <Setter Property="BoxShadow" Value="0 0 14 2 #8055B9FF" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>
        <Border Background="#E6101928"
                BorderBrush="#304761"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,8"
                Margin="18,0,18,8"
                IsVisible="{Binding ChannelPickerVisible}">
          <StackPanel Spacing="6">
            <TextBlock Text="КАНАЛЫ В ГРУППЕ" Foreground="#91A6BF" FontSize="11" FontWeight="Bold" />
            <ListBox x:Name="ChannelPickerList"
                     Height="82"
                     Classes="channel-picker-list"
                     ItemsSource="{Binding ChannelPickerItems}"
                     SelectedItem="{Binding SelectedChannelPickerItem, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     PointerWheelChanged="OnChannelPickerPointerWheelChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="2,0,4,0" />
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </ControlTheme>
              </ListBox.ItemContainerTheme>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="channel-picker-tile"
                          Width="76"
                          Height="72"
                          Background="#162130"
                          BorderBrush="#304054"
                          BorderThickness="1"
                          CornerRadius="12"
                          Padding="6">
                    <Grid RowDefinitions="*,Auto">
                      <Image asyncImageLoader:ImageLoader.Source="{Binding Channel.Logo}"
                             MaxWidth="54"
                             Margin="0,0,0,4"
                             Stretch="Uniform" />
                      <TextBlock Grid.Row="1"
                                 Text="{Binding Name}"
                                 FontSize="10"
                                 Foreground="#F5F8FF"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 MaxHeight="26"
                                 HorizontalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>

</UserControl>
