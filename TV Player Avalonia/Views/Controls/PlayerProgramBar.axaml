<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TV_Player.AvaloniaApp.Views.Controls.PlayerProgramBar">
  <Grid HorizontalAlignment="Stretch">
      <!-- Bottom EPG carousel, matching the Android player layout. -->
      <Border x:Name="GuidePanel" 
              VerticalAlignment="Center"
              HorizontalAlignment="Stretch"
              Padding="4,6"
              Background="Transparent"
              BorderThickness="0"
              IsVisible="{Binding ShowProgramGuideInBar}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <ScrollViewer Grid.Column="0" x:Name="ProgramGuideScroll"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        PointerWheelChanged="OnProgramGuidePointerWheelChanged">
            <ItemsControl ItemsSource="{Binding Programs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="200" MinHeight="72" Padding="10,6"
                          Background="#162130" BorderBrush="#304054"
                          BorderThickness="1" CornerRadius="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                 MaxHeight="48" FontSize="14" FontWeight="SemiBold"
                                 Foreground="White" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding StartTime, StringFormat='{}{0:HH:mm}'}"
                                   FontSize="12" Foreground="#8DD2FF" />
                        <TextBlock Text="–" FontSize="12" Foreground="#8DD2FF" />
                        <TextBlock Text="{Binding EndTime, StringFormat='{}{0:HH:mm}'}"
                                   FontSize="12" Foreground="#8DD2FF" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Button Width="36" Height="36" VerticalAlignment="Center"
                  Classes="toolbar-flat" Content="✕" ToolTip.Tip="Закрыть программу передач"
                  Command="{Binding ShowProgramListCommand}" />
        </Grid>
      </Border>


        <Button Classes="toolbar-flat"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                IsVisible="{Binding ShowCurrentProgramInBar}"
                Command="{Binding ShowProgramListCommand}">
          <StackPanel Spacing="3" HorizontalAlignment="Stretch">
            <TextBlock FontSize="18"
                       Foreground="White"
                       Text="{Binding ProgramGuideText}"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <TextBlock FontSize="13" Foreground="#F5F5F5" Text="{Binding StartProgram}" VerticalAlignment="Center" />
              <ProgressBar x:Name="GuideProgress" Height="8" Foreground="#8DD2FF" Value="{Binding DurationValue}" Maximum="100" Width="240" VerticalAlignment="Center" />
              <TextBlock FontSize="13" Foreground="#F5F5F5" Text="{Binding EndProgram}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Button>


  </Grid>
</UserControl>
