<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TV_Player.AvaloniaApp.Views.SettingsView">
  <UserControl.Styles>
    <Style Selector="Button.settings-tab">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#A9BDD5" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="MinHeight" Value="50" />
    </Style>
    <Style Selector="Button.settings-tab:pointerover">
      <Setter Property="Background" Value="#1C2B3D" />
      <Setter Property="Foreground" Value="#F5F8FF" />
    </Style>
    <Style Selector="Button.settings-tab.active">
      <Setter Property="Background" Value="#1A4263" />
      <Setter Property="Foreground" Value="#F5F8FF" />
      <Setter Property="BorderBrush" Value="#3B91CC" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto" Margin="12">
    <Grid Grid.Row="0" ColumnDefinitions="180,*">
      <Border Grid.Column="0" Margin="0,0,14,0" Background="#101A28" BorderBrush="#24364B" BorderThickness="1" CornerRadius="16" Padding="10">
        <StackPanel Spacing="8">
          <TextBlock Text="SETTINGS" Foreground="#7188A3" FontSize="11" FontWeight="Bold" Margin="12,10,0,8" />
          <Button Classes="settings-tab" Classes.active="{Binding IsSourcesSection}" Command="{Binding ShowSourcesSectionCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="▤" FontSize="18" />
              <TextBlock Text="Sources" FontSize="15" />
            </StackPanel>
          </Button>
          <Button Classes="settings-tab" Classes.active="{Binding IsPluginsSection}" Command="{Binding ShowPluginsSectionCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="◈" FontSize="18" />
              <TextBlock Text="Plugins" FontSize="15" />
            </StackPanel>
          </Button>
          <Button Classes="settings-tab" Classes.active="{Binding IsPlaybackSection}" Command="{Binding ShowPlaybackSectionCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="⚙" FontSize="18" />
              <TextBlock Text="Playback" FontSize="15" />
            </StackPanel>
          </Button>
          <Border Height="1" Background="#26384D" Margin="4,10" />
          <TextBlock Text="Changes apply when saved" Foreground="#7188A3" FontSize="12" TextWrapping="Wrap" Margin="10,0" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Background="#101A28" BorderBrush="#24364B" BorderThickness="1" CornerRadius="16" Padding="20">
        <Grid>
          <!-- Sources -->
          <Grid IsVisible="{Binding IsSourcesSection}" RowDefinitions="Auto,Auto,*,Auto">
            <StackPanel Spacing="4">
              <TextBlock Text="Sources" Foreground="#F5F8FF" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="Manage your M3U playlists." Foreground="#91A6BF" FontSize="13" />
            </StackPanel>
            <Border Grid.Row="1" Margin="0,14,0,0" Background="#141F2E" BorderBrush="#273B53" BorderThickness="1" CornerRadius="13" Padding="14">
              <Grid ColumnDefinitions="*,*,Auto">
                <TextBox Margin="0,0,5,0" Text="{Binding PlaylistURL}" Watermark="Playlist URL" />
                <TextBox Grid.Column="1" Margin="5,0" Text="{Binding PlaylistName}" Watermark="Playlist name" />
                <Button Grid.Column="2" Classes="handheld-primary" Command="{Binding AddPlaylistCommand}" Padding="14,0">
                  <TextBlock Text="Add playlist" />
                </Button>
              </Grid>
            </Border>
            <Border Grid.Row="2" Margin="0,14,0,0" Background="#141F2E" BorderBrush="#273B53" BorderThickness="1" CornerRadius="13" Padding="8">
              <ListBox ItemsSource="{Binding Playlists}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemContainerTheme>
                  <ControlTheme TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,3" />
                  </ControlTheme>
                </ListBox.ItemContainerTheme>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="180,*,Auto" MinHeight="56">
                      <TextBlock Text="{Binding Key}" Foreground="#F5F8FF" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#A9BDD5" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="2" Classes="handheld-danger" Width="44" Height="44" CommandParameter="{Binding}" Command="{Binding DataContext.PlaylistDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <TextBlock Text="−" FontSize="20" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
            <Border Grid.Row="3" Margin="0,12,0,0" Background="#141F2E" BorderBrush="#273B53" BorderThickness="1" CornerRadius="13" Padding="10">
              <StackPanel Spacing="6">
                <TextBlock Text="Provider sources" Foreground="#F5F8FF" FontSize="14" FontWeight="SemiBold" Margin="4,0,4,2" />
                <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding PluginSources}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" MinHeight="48" Margin="4,1">
                          <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Name}" Foreground="#F5F8FF" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PluginId}" Foreground="#91A6BF" FontSize="11" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="handheld-danger" Width="40" Height="40" CommandParameter="{Binding}" Command="{Binding DataContext.PluginSourceDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock Text="−" FontSize="20" />
                          </Button>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock IsVisible="{Binding IsNoProviderSources}" Text="No provider sources added yet." Foreground="#7188A3" FontSize="12" Margin="4,0" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- Plugins -->
          <ScrollViewer IsVisible="{Binding IsPluginsSection}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
              <StackPanel Spacing="4">
                <TextBlock Text="Provider plugins" Foreground="#F5F8FF" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Create sources from installed website or service plugins." Foreground="#91A6BF" FontSize="13" TextWrapping="Wrap" />
              </StackPanel>
              <Border Background="#141F2E" BorderBrush="#273B53" BorderThickness="1" CornerRadius="13" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="Plugin folder" Foreground="#A9BDD5" FontSize="13" />
                  <TextBlock Text="{Binding PluginDirectory}" Foreground="#8DD2FF" FontSize="13" TextWrapping="Wrap" />
                  <TextBlock Text="Development build output (loaded automatically)" Foreground="#A9BDD5" FontSize="13" />
                  <TextBlock Text="{Binding DevelopmentPluginDirectory}" Foreground="#8DD2FF" FontSize="13" TextWrapping="Wrap" />
                  <TextBlock Text="Plugin request log" Foreground="#A9BDD5" FontSize="13" />
                  <TextBlock Text="{Binding PluginLogPath}" Foreground="#8DD2FF" FontSize="13" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PluginAvailabilityMessage}" Foreground="#A9BDD5" FontSize="13" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PluginLoadErrors}" Foreground="#FF9B91" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Background="#141F2E" BorderBrush="#273B53" BorderThickness="1" CornerRadius="13" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="Add provider source" Foreground="#F5F8FF" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="Added sources appear in the Sources tab. Save changes to load them." Foreground="#7188A3" FontSize="12" TextWrapping="Wrap" />
                  <ComboBox ItemsSource="{Binding AvailableProviderPlugins}" SelectedItem="{Binding SelectedProviderPlugin, Mode=TwoWay}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox Text="{Binding NewPluginSourceName, Mode=TwoWay}" Watermark="Source name" />
                  <ItemsControl ItemsSource="{Binding PluginSettingEditors}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Spacing="4" Margin="0,4">
                          <TextBlock Text="{Binding Label}" Foreground="#A9BDD5" FontSize="13" />
                          <TextBlock Text="{Binding Description}" Foreground="#7188A3" FontSize="12" TextWrapping="Wrap" />
                          <TextBox Text="{Binding Value, Mode=TwoWay}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding PluginSourceError}" Foreground="#FF9B91" FontSize="13" TextWrapping="Wrap" />
                  <Button Classes="handheld-primary" Command="{Binding AddPluginSourceCommand}" HorizontalAlignment="Left" Padding="16,0">
                    <TextBlock Text="Add source" />
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Playback -->
          <StackPanel IsVisible="{Binding IsPlaybackSection}" Spacing="14">
            <StackPanel Spacing="4">
              <TextBlock Text="Playback" Foreground="#F5F8FF" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Text="Choose how the player starts and displays video." Foreground="#91A6BF" FontSize="13" />
            </StackPanel>
            <Border Background="#141F2E" BorderBrush="#273B53" BorderThickness="1" CornerRadius="13" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Text="Playback engine" Foreground="#A9BDD5" FontSize="13" />
                <ComboBox ItemsSource="{Binding PlaybackEngines}" SelectedItem="{Binding SelectedPlaybackEngine}" HorizontalAlignment="Left" MinWidth="220" />
                <TextBlock Text="mpv requires native integration; VLC is currently used for video." Foreground="#7188A3" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Background="#141F2E" BorderBrush="#273B53" BorderThickness="1" CornerRadius="13" Padding="12">
              <StackPanel>
                <CheckBox IsChecked="{Binding StartFullScreen}" Content="Start fullscreen" />
                <CheckBox IsChecked="{Binding StartLastScreen}" Content="Remember last channel" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="194,12,0,0">
      <TextBlock Text="Settings are saved together" Foreground="#7188A3" FontSize="12" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="handheld-primary" Command="{Binding SaveCommand}" Padding="20,0">
        <TextBlock Text="Save changes" />
      </Button>
    </Grid>
  </Grid>
</UserControl>
