<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TV_Player</RootNamespace>
    <AssemblyName>TV Player Avalonia</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AsyncImageLoader.Avalonia" Version="3.7.0" />
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="LibVLCSharp" Version="3.9.6" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.9.6" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Reactive" Version="6.0.2" />
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1" Condition="$([MSBuild]::IsOSPlatform('macos'))" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23" Condition="$([MSBuild]::IsOSPlatform('windows'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TV Player Core\TV Player Core.csproj" />
    <ProjectReference Include="..\Examples\HtmlPageStreamsPlugin\HtmlPageStreamsPlugin.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**\*" />
  </ItemGroup>

  <Target Name="CopyProviderPlugins" AfterTargets="ResolveProjectReferences">
    <PropertyGroup>
      <_ProviderPluginOutput>$(MSBuildThisFileDirectory)..\Examples\HtmlPageStreamsPlugin\bin\$(Configuration)\net10.0</_ProviderPluginOutput>
      <_ProviderPluginDestination>$(OutDir)Plugins\HtmlPageStreamsPlugin</_ProviderPluginDestination>
    </PropertyGroup>
    <MakeDir Directories="$(_ProviderPluginDestination)" />
    <ItemGroup>
      <_ProviderPluginFiles Include="$(_ProviderPluginOutput)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ProviderPluginFiles)"
          DestinationFiles="@(_ProviderPluginFiles->'$(_ProviderPluginDestination)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
